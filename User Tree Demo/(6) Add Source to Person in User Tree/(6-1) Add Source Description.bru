meta {
  name: (6-1) Add Source Description
  type: http
  seq: 1
}

post {
  url: {{domain}}/sources/descriptions
  body: json
  auth: inherit
}

headers {
  Accept: application/x-fs-v1+json
  Content-Type: application/x-fs-v1+json
}

body:json {
   { "sourceDescriptions": [
      {
        "citations": [
          {
            "value": "\"United States Census, 1900.\" database and digital images, FamilySearch (https://familysearch.org/: accessed 17 Mar 2012), Ethel Hollivet, 1900; citing United States Census Office, Washington, D.C., 1900 Population Census Schedules, Los Angeles, California, population schedule, Los Angeles Ward 6, Enumeration District 58, p. 20B, dwelling 470, family 501, FHL microfilm 1,240,090; citing NARA microfilm publication T623, roll 90."
          }
        ],
        "titles": [
          {
            "value": "1900 US Census, Ethel Hollivet"
          }
        ],
        "notes": [
          {
            "text": "Ethel Hollivet (line 75) with husband Albert Hollivet (line 74); also in the dwelling: step-father Joseph E Watkins (line 72), mother Lina Watkins (line 73), and grandmother -- Lina's mother -- Mary Sasnett (line 76).  Albert's mother and brother also appear on this page -- Emma Hollivet (line 68), and Eddie (line 69)."
          }
        ]
      }
    ]
  }
}

script:post-response {
  let sourceDescription1Id = res.headers["x-entity-id"];
  
  // If the header exists, store it as an environment variable
  if (sourceDescription1Id) {
      bru.setEnvVar("sourceDescription1Id", sourceDescription1Id);
  }
  
}

tests {
  // postman.setGlobalVariable("sourceDescription1Id", res.getHeader("X-Entity-Id"));
}

docs {
  The /sources/descriptions endpoint creates a source definition based on the properties specified in the Request Body.
  
  The id of the new source description is persisted in this collection in the global variable sourceDescription1Id.
  
  If the status code from this request is 201 Created, proceed to (6-2) Add Source Reference to Person.
}
