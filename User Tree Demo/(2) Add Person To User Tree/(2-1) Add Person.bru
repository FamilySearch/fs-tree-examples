script:post-response {
  // Get the 'X-Entity-Id' header from the response
  let person1Id = res.headers["x-entity-id"];
  
  // If the header exists, store it as an environment variable
  if (person1Id) {
      bru.setEnvVar("person1Id", person1Id);
  }
  
}

tests {
  // postman.setGlobalVariable("person1Id", res.getHeader("X-Entity-Id"));
}

docs {
  The /tree/persons endpoint creates a new person record based on the information provided in the Request Body. The request body specifies the Tree Id of the new user tree created in Step (1-4).
  
  This request in the collection persists the Person Id as person1Id in the global variables. This person ID will be used as the starting person in Step (3-1).
  
  If the status code from this request is 201 Created, proceed to (2-2) Add Person.
}
