meta {
  name: (2-6) Set Current Tree to  GLOBAL Tree
  type: http
  seq: 6
}

post {
  url: {{domain}}/trees/current
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "trees" : [ {
      "id" : "GLOBAL"
    } ]
  }
}

docs {
  POST /trees/current with a request body that provides a tree ID value "GLOBAL" will set the current tree for the session to the FamilySearch tree.
  
  If the status code from this request is 204 Created, proceed to (2-7) Get Current Tree to confirm the current tree has been reset to GLOBAL
}
