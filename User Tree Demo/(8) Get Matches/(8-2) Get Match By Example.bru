meta {
  name: (8-2) Get Match By Example
  type: http
  seq: 2
}

post {
  url: {{domain}}/tree/matches?count=10&collection=cet&treeId={{treeId}}
  body: json
  auth: inherit
}

params:query {
  count: 10
  collection: cet
  treeId: {{treeId}}
}

headers {
  ~Accept: application/x-gedcomx-atom+json
}

body:json {
  {
    "description" : "#sd1",
    "persons" : [
             {
              "id": "primaryPerson",
              "living": false,
              "gender": {
                  "type": "http://gedcomx.org/Male"
              },
              "links": {
                  "person": {
                    "href": "https://apibeta.familysearch.org/platform/tree/persons/B9FD-56P?flag=fsh"
                  }
              },
              "identifiers": {
                  "http://gedcomx.org/Persistent": [
                    "https://familysearch.org/ark:/61903/4:1:B9FD-56P"
                 ]
              },
              "names": [
                  {
                    "type": "http://gedcomx.org/BirthName",
                    "preferred": true,
                    "nameForms": [
                      {
                        "lang": "en",
                        "fullText": "William Heaton",
                        "parts": [
                          {
                            "type": "http://gedcomx.org/Given",
                            "value": "William"
                          },
                          {
                            "type": "http://gedcomx.org/Surname",
                            "value": "Heaton"
                          }
                        ]
                      }
                    ]
                  }
              ],
              "facts": [
                  {
                    "type": "http://gedcomx.org/Death",
                    "date": {
                      "original": "22 September 1877",
                      "formal": "+1877-09-22",
                      "normalized": [
                        {
                          "lang": "en-US",
                          "value": "22 September 1877"
                        }
                      ]
                    },
                    "place": {
                      "id": "5352266",
                      "original": "Orderville, Kane, Utah, United States",
                      "description": "#5352266",
                      "normalized": [
                        {
                          "lang": "en-US",
                          "value": "Orderville, Kane, Utah, United States"
                        }
                      ]
                    }
                  }
              ]
          } 
      ]
  }
                  
   
}

docs {
  The /tree/persons/{{personId}}/matches endpoint requests a list of match hints for the person specified by personId. The response may contain match hints from the user tree or the main Family Tree. See the documentation at [https://www.familysearch.org/developers/docs/api/tree/Match_by_Tree_Person_Id_resource](https://www.familysearch.org/developers/docs/api/tree/Match_by_Tree_Person_Id_resource).
  
  Please note that there is some acceptable system latency between when a person is created and their match hints are available via the tree/persons/{personId}/matches endpoint.
  
  If the status code from this request is 204 No Content, no results were found. Wait and allow time for a response of 200 OK. See the example request and response documents at [https://www.familysearch.org/developers/docs/api/tree/Read_Matches_by_Tree_Person_Id_usecase](https://www.familysearch.org/developers/docs/api/tree/Read_Matches_by_Tree_Person_Id_usecase).
  
  If the status code from this request is 200 OK, proceed to (20) Get Tree Person IDs.
}
