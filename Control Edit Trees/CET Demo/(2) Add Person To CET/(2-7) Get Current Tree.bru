meta {
  name: (2-7) Get Current Tree
  type: http
  seq: 7
}

get {
  url: {{domain}}/trees/current
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

docs {
  GET /trees/current will return the tree ID of the currently selected tree in the response body.
  
  If the status code from this request is 200 OK and the value of the tree ID is "GLOBAL", proceed to (3-1) Tree Detail
}
