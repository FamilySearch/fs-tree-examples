meta {
  name: (4-2) Create Parent Child Relationship
  type: http
  seq: 2
}

post {
  url: {{domain}}/tree/relationships
  body: json
  auth: inherit
}

headers {
  Content-Type: application/x-fs-v1+json
  Accept: application/x-fs-v1+json
}

body:json {
  {
   "childAndParentsRelationships" : [ {
    "parent1" : {
      "resource" : "http://beta.familysearch.org/platform/tree/persons/{{person1Id}}"
    },
    "parent2" : {
      "resource" : "http://beta.familysearch.org/platform/tree/persons/{{person2Id}}"
    },
    "child" : {
      "resource" : "http://beta.familysearch.org/platform/tree/persons/{{person3Id}}"
    }
   } ]
  }
}

docs {
  The /tree/relationships endpoint creates a relationship based on the information provided in the Request Body. The request body provided in this request creates a childAndParentsRelationship with the persons specified in person1Id and person2Id as parent1 and parent2, and person3 Idis the child.
  
  If the status code from this request is 201 Created, proceed to (5-1) Add Note.
}
